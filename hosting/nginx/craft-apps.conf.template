#
# nginx server for the Craft apps: /<app>/ serves an unpacked web build with the translator
# added by inject-translator.sh. The headers follow docs/hosting.md#headers. It serves every file
# in the folder: remove what the apps do not need first, such as the Cargo build leftovers in
# LightCraft's release (docs/hosting.md#files-to-serve).
#
# A template for the official nginx images (nginx, nginxinc/nginx-unprivileged): put it in
# /etc/nginx/templates/; at start their entrypoint replaces ${CRAFTSUITE_ALLOWED_ORIGINS} with
# that environment variable and writes the result to /etc/nginx/conf.d/. Give the updater the
# same variable for inject-translator.sh, so frame-ancestors and data-allowed-origins always list
# the same Nextcloud origins (separated by spaces). Without the images' entrypoint, write the
# origins in by hand.
#
# TLS is left to a reverse proxy in front. Behind a login gate, use "private" instead of
# "public" in Cache-Control.

server {
  listen 8080;
  root /srv/craft;
  index index.html;

  server_tokens off;
  absolute_redirect off;   # relative redirects (/pdfcraft -> /pdfcraft/) behind a proxy
  charset utf-8;           # text/html; charset=utf-8

  include /etc/nginx/mime.types;   # has application/wasm for .wasm
  types {
    font/ttf ttf;
    font/otf otf;            # LightCraft's 16 MB lightcraft_zh_hans.otf
    text/javascript mjs;
  }

  # Compression: .gz files written once per release (gzip -9 -k), else on the fly.
  gzip_static on;
  gzip on;
  gzip_vary on;
  gzip_proxied any;        # also for requests that came through a proxy (Via header)
  gzip_comp_level 5;
  gzip_types text/css text/plain text/javascript application/javascript application/wasm
    application/json image/svg+xml font/ttf font/otf;

  # Hidden files: temporary files of the updater and the injector, .htaccess, Cargo's
  # .fingerprint/ and .cargo-*lock in LightCraft's release.
  location ~ /\. {
    return 404;
  }

  # The translator: fixed names, so browsers check for a new version on every load. The
  # injector also adds a checksum to their URLs (?v=...). Before the hashed names below, so that
  # no translator file is ever cached as immutable.
  location ~ ^/[^/]+/craftsuite-layer/ {
    add_header Cache-Control "no-cache" always;
    add_header Content-Security-Policy "frame-ancestors ${CRAFTSUITE_ALLOWED_ORIGINS}" always;
    add_header X-Content-Type-Options "nosniff" always;
  }

  # JavaScript and WebAssembly whose names carry Trunk's content hash, such as
  # pdfcraft-web-9fbc20856b2df0f8.js and pdfcraft-web-9fbc20856b2df0f8_bg.wasm: new content gets
  # a new name, so browsers may keep them for a year. Trunk writes the 64-bit hash in hex
  # without leading zeros (vectorcraft-web-243cdb1020baca4.js has 15 digits), hence 8 to 16.
  # In quotes because of the braces.
  location ~ "-[0-9a-f]{8,16}(_bg)?\.(js|wasm)$" {
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    add_header Content-Security-Policy "frame-ancestors ${CRAFTSUITE_ALLOWED_ORIGINS}" always;
    add_header X-Content-Type-Options "nosniff" always;
  }

  # index.html, sw.js and everything else, also JavaScript and WebAssembly without a hash in
  # their names (EffectCraft's, FilmCraft's and LightCraft's effectcraft_web.js,
  # filmcraft_web_bg.wasm, worker.js, audio-worklet.js, ...), which keep their names from one
  # release to the next: revalidate, so that a new release takes effect on reload, also when it
  # replaces the old one under the same path. An immutable cache would keep the old glue and
  # .wasm for a year next to a new index.html.
  location / {
    add_header Cache-Control "no-cache" always;
    add_header Content-Security-Policy "frame-ancestors ${CRAFTSUITE_ALLOWED_ORIGINS}" always;
    add_header X-Content-Type-Options "nosniff" always;
  }
}
